<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd">

    <targets>
        <target name="workerlogs" xsi:type="File" fileName="${basedir}/logs/${shortdate}.log" layout="${longdate}|${level:uppercase=true}|${logger}|${message:withexception=true}" maxArchiveDays="7" />
    </targets>

    <rules>
        <logger name="Microsoft.EntityFrameworkCore.Database.Command" maxlevel="Info" final="true" />
        <logger name="*" minlevel="Info" writeTo="workerlogs" />
    </rules>
</nlog>